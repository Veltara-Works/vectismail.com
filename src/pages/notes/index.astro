---
import '../../styles/custom.css'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteNav from "../../components/SiteNav.astro"
import { getCollection } from 'astro:content'

const title = 'Notes — Vectis Mail'
const description = 'Essays, analysis, and field-notes from the people building Vectis Mail. Published when there is something worth saying.'
const url = 'https://vectismail.com/notes/'

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
)

const fmtDate = (d: Date) =>
	d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })
---
<html lang="en">
<head>
	<link rel="preload" href="/brand/fonts/Inter-VariableFont_opsz_wght.woff2" as="font" type="font/woff2" crossorigin />
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />

	<link rel="canonical" href={url} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />

	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={url} />
	<meta property="og:image" content="https://vectismail.com/og/default.png" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Vectis Mail — Notes" />
	<meta property="og:site_name" content="Vectis Mail" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content="https://vectismail.com/og/default.png" />

	<meta name="theme-color" content="#0C0C0D" />
</head>
<body class="marketing-page">
	<SiteNav />

	<main>
		<section class="section" style="max-width: 760px;">
			<h1>Notes</h1>
			<p class="notes-intro">
				Essays and analysis from the people building Vectis Mail. Published when there is something worth saying, not on a schedule.
			</p>

			{notes.length === 0 ? (
				<p class="notes-empty">Nothing here yet.</p>
			) : (
				<ul class="notes-list">
					{notes.map((note) => (
						<li class="notes-item">
							<a href={`/notes/${note.id}/`} class="notes-link">
								<time datetime={note.data.pubDate.toISOString()} class="notes-date">
									{fmtDate(note.data.pubDate)}
								</time>
								<h2 class="notes-title">{note.data.title}</h2>
								{note.data.excerpt && (
									<p class="notes-excerpt">{note.data.excerpt}</p>
								)}
							</a>
						</li>
					))}
				</ul>
			)}
		</section>
	</main>

	<SiteFooter />
</body>
</html>

<style>
	.notes-intro {
		color: var(--sl-color-gray-2);
		line-height: 1.7;
		font-size: 1.05rem;
		margin-bottom: 3rem;
	}

	.notes-empty {
		color: var(--sl-color-gray-3);
		font-style: italic;
	}

	.notes-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.notes-item {
		border-top: 1px solid var(--vm-border);
		padding: 1.75rem 0;
	}
	.notes-item:last-child {
		border-bottom: 1px solid var(--vm-border);
	}

	.notes-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.notes-date {
		display: block;
		color: var(--sl-color-gray-3);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.notes-title {
		color: var(--sl-color-white);
		font-size: 1.4rem;
		font-weight: 700;
		line-height: 1.3;
		margin: 0 0 0.6rem 0;
		transition: color 0.15s;
	}

	.notes-link:hover .notes-title {
		color: var(--vm-cyan);
	}

	.notes-excerpt {
		color: var(--sl-color-gray-2);
		font-size: 1rem;
		line-height: 1.6;
		margin: 0;
	}
</style>
