---
import '../../styles/custom.css'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteNav from "../../components/SiteNav.astro"
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
	const notes = await getCollection('notes')
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}))
}

const { note } = Astro.props
const { Content } = await render(note)

const url = `https://vectismail.com/notes/${note.id}/`
const title = `${note.data.title} — Vectis Mail`
const description = note.data.description
const ogImage = 'https://vectismail.com/og/default.png'
const datePublished = note.data.pubDate.toISOString()
const dateModified = (note.data.updated ?? note.data.pubDate).toISOString()

const fmtDate = (d: Date) =>
	d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />

	<link rel="canonical" href={url} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />

	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="article" />
	<meta property="og:url" content={url} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content={note.data.title} />
	<meta property="og:site_name" content="Vectis Mail" />
	<meta property="article:published_time" content={datePublished} />
	<meta property="article:modified_time" content={dateModified} />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	<meta name="theme-color" content="#0C0C0D" />

	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "BreadcrumbList",
				"itemListElement": [
					{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://vectismail.com/" },
					{ "@type": "ListItem", "position": 2, "name": "Notes", "item": "https://vectismail.com/notes/" },
					{ "@type": "ListItem", "position": 3, "name": note.data.title, "item": url }
				]
			},
			{
				"@type": "Article",
				"@id": url + "#article",
				"headline": note.data.title,
				"description": description,
				"url": url,
				"image": ogImage,
				"datePublished": datePublished,
				"dateModified": dateModified,
				"author": { "@type": "Person", "name": "Ian Holt", "url": "https://vectismail.com/about/" },
				"publisher": {
					"@type": "Organization",
					"name": "Vectis Mail",
					"logo": { "@type": "ImageObject", "url": "https://vectismail.com/brand/logos/vectis-mail-logo-white.webp" }
				}
			}
		]
	})} />
</head>
<body class="marketing-page">
	<SiteNav />

	<main>
		<article class="section note-article">
			<header class="note-header">
				<a href="/notes/" class="note-back">← All notes</a>
				<time datetime={datePublished} class="note-date">{fmtDate(note.data.pubDate)}</time>
				<h1 class="note-title">{note.data.title}</h1>
				<p class="note-byline">Written by Ian Holt</p>
			</header>

			<div class="note-prose">
				<Content />
			</div>

			<footer class="note-footer">
				<a href="/notes/" class="note-back">← All notes</a>
			</footer>
		</article>
	</main>

	<SiteFooter />
</body>
</html>

<style is:global>
	.note-article {
		max-width: 720px;
	}

	.note-header {
		margin-bottom: 2.5rem;
	}

	.note-back {
		display: inline-block;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
		transition: color 0.15s;
	}
	.note-back:hover {
		color: var(--vm-cyan);
	}

	.note-date {
		display: block;
		color: var(--sl-color-gray-3);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.note-title {
		color: var(--sl-color-white);
		font-size: 2.25rem;
		font-weight: 800;
		line-height: 1.2;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.note-byline {
		color: var(--sl-color-gray-3);
		font-size: 0.9rem;
		font-weight: 500;
		margin: 0.75rem 0 0;
	}

	.note-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--vm-border);
	}

	/* ── Rendered markdown prose styles ────────────────────────────── */
	.note-prose {
		color: var(--sl-color-gray-1);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.note-prose > * + * {
		margin-top: 1.25rem;
	}

	.note-prose h2 {
		color: var(--sl-color-white);
		font-size: 1.55rem;
		font-weight: 700;
		line-height: 1.3;
		margin-top: 3rem;
		margin-bottom: 1rem;
		letter-spacing: -0.005em;
	}

	.note-prose h3 {
		color: var(--sl-color-white);
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1.35;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
	}

	.note-prose p {
		color: var(--sl-color-gray-2);
	}

	.note-prose strong {
		color: var(--sl-color-white);
		font-weight: 700;
	}

	.note-prose a {
		color: var(--vm-cyan);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.note-prose a:hover {
		color: var(--sl-color-accent-high);
	}

	.note-prose ul,
	.note-prose ol {
		color: var(--sl-color-gray-2);
		padding-left: 1.5rem;
	}
	.note-prose li {
		margin-top: 0.5rem;
	}
	.note-prose li::marker {
		color: var(--sl-color-gray-4);
	}

	.note-prose blockquote {
		border-left: 3px solid var(--vm-cyan);
		padding-left: 1.25rem;
		color: var(--sl-color-gray-2);
		font-style: italic;
	}

	.note-prose code {
		font-family: var(--sl-font-system-mono);
		font-size: 0.92em;
		background: var(--vm-bg-card);
		border: 1px solid var(--vm-border);
		border-radius: 4px;
		padding: 0.1em 0.4em;
		color: var(--vm-cyan);
	}

	.note-prose pre {
		background: var(--vm-bg-card);
		border: 1px solid var(--vm-border);
		border-radius: 6px;
		padding: 1rem 1.25rem;
		overflow-x: auto;
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.note-prose pre code {
		background: transparent;
		border: none;
		padding: 0;
		color: var(--sl-color-gray-1);
	}

	/* Tables: horizontal-scroll wrapper for narrow viewports.
	   The wrapper is added in the markdown via <div class="table-scroll">. */
	.note-prose .table-scroll {
		max-width: 100%;
		overflow-x: auto;
		margin: 1.75rem 0;
		/* Hint that it's scrollable on touch devices */
		-webkit-overflow-scrolling: touch;
	}

	.note-prose .table-scroll table,
	.note-prose table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		margin: 1.75rem 0;
	}
	.note-prose .table-scroll table {
		margin: 0;
		/* Keep cells readable on mobile by setting a min-width
		   below which we scroll horizontally instead of crushing. */
		min-width: 480px;
	}

	.note-prose th,
	.note-prose td {
		padding: 0.9rem 1rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--vm-border);
	}
	.note-prose th {
		background: var(--vm-bg-card);
		color: var(--sl-color-white);
		font-weight: 700;
		font-size: 0.92rem;
		letter-spacing: 0.01em;
		/* Stronger header/body separator — the cyan accent
		   reads as "this row is special" without being loud. */
		border-bottom: 2px solid var(--vm-cyan);
		padding-top: 1rem;
		padding-bottom: 1rem;
	}
	.note-prose td {
		color: var(--sl-color-gray-2);
	}
	/* Drop the bottom border on the final row so it doesn't double up
	   against the next section heading or paragraph. */
	.note-prose tr:last-child td {
		border-bottom: none;
	}

	/* Narrow viewport polish */
	@media (max-width: 600px) {
		.note-prose .table-scroll table,
		.note-prose table {
			font-size: 0.88rem;
		}
		.note-prose th,
		.note-prose td {
			padding: 0.7rem 0.75rem;
		}
	}

	.note-prose hr {
		border: none;
		border-top: 1px solid var(--vm-border);
		margin: 2.5rem 0;
	}

	.note-prose em {
		color: var(--sl-color-gray-2);
	}
</style>
