---
import "../../styles/custom.css"
import SiteNav from "../../components/SiteNav.astro"
const title = "Unsubscribed — Vectis Mail"
const description = "You've been removed from the Vectis Mail product-updates list."
---
<html lang="en">
<head>
	<link rel="preload" href="/brand/fonts/Inter-VariableFont_opsz_wght.woff2" as="font" type="font/woff2" crossorigin />
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://vectismail.com/newsletter/unsubscribed/" />
	<meta property="og:site_name" content="Vectis Mail" />
	<meta name="theme-color" content="#0C0C0D" />
	<meta name="robots" content="noindex, follow" />
	<link rel="canonical" href="https://vectismail.com/newsletter/unsubscribed/" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
</head>
<body class="marketing-page">
	<SiteNav />

	<main>
	<section class="section" style="max-width: 640px;">
		<h1>You're unsubscribed.</h1>
		<p class="subtitle">You've been removed from the Vectis Mail product-updates list and won't receive any more. No hard feelings.</p>

		<div class="feature-card" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
			<p style="margin: 0;">Changed your mind? You can re-subscribe any time from the footer of <a href="/" style="color: var(--sl-color-accent);">vectismail.com</a> — it takes a single confirmation click.</p>
		</div>

		<a href="/" class="btn-primary" style="display: inline-block;">Back to vectismail.com</a>
	</section>
	</main>

	<footer class="footer">
		<span>&copy; 2026 Veltara Works&trade;. All rights reserved.</span>
		<div>
			<a href="/">Home</a> &nbsp;&middot;&nbsp;
			<a href="/contact/">Contact</a> &nbsp;&middot;&nbsp;
			<a href="/privacy/">Privacy</a>
		</div>
	</footer>
</body>
</html>
