---
import "../../styles/custom.css"
import SiteFooter from "../../components/SiteFooter.astro"
const title = 'Checkout cancelled — Vectis Mail'
const description = 'Your Vectis Mail Pro checkout was cancelled. You can try again any time.'
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://vectismail.com/upgrade/cancelled/" />
	<meta property="og:site_name" content="Vectis Mail" />
	<meta name="theme-color" content="#0C0C0D" />
	<meta name="robots" content="noindex, follow" />
	<link rel="canonical" href="https://vectismail.com/upgrade/cancelled/" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
</head>
<body class="marketing-page">
	<nav class="marketing-nav">
		<a href="/" class="logo"><img src="/brand/logos/vectis-mail-logo-white.webp" alt="Vectis Mail" width="181" height="34" /></a>
		<div>
			<a href="/features/">Features</a>
			<a href="/pricing/">Pricing</a>
			<a href="/alternatives/">Compare</a>
			<a href="/getting-started/">Docs</a>
			<a href="/notes/">Notes</a>
			<a href="/about/">About</a>
			<a href="/contact/">Contact</a>
		</div>
	</nav>

	<main>

	<section class="section" style="max-width: 640px;">
		<h1>Checkout cancelled</h1>
		<p class="subtitle">No charges were made. You can try again any time — your details aren't saved.</p>

		<div class="feature-card" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
			<h3 style="margin-top: 0;">Common reasons people pause here</h3>
			<ul style="margin-top: 0.75rem; padding-left: 1.25rem;">
				<li><strong>Want to try Vectis Mail first?</strong> The Starter tier is free forever — 3 domains, 25 mailboxes per domain. <a href="/getting-started/installation/" style="color: var(--sl-color-accent);">Install in ~10 minutes</a> and upgrade later.</li>
				<li><strong>Need a feature comparison?</strong> <a href="/pricing/#compare" style="color: var(--sl-color-accent);">Starter vs Pro side-by-side</a>.</li>
				<li><strong>Looking for Enterprise pricing?</strong> Clustering, multi-tenant, compliance — <a href="/contact/?reason=sales" style="color: var(--sl-color-accent);">talk to sales</a>.</li>
				<li><strong>Pricing concerns?</strong> $39 USD/mo is per tenant, not per install — one subscription covers every Vectis Mail server you operate. <a href="/contact/?reason=general" style="color: var(--sl-color-accent);">Questions welcome</a>.</li>
			</ul>
		</div>

		<a href="/upgrade/" class="btn-primary" style="display: inline-block;">Try checkout again</a>
		<a href="/pricing/" style="display: inline-block; margin-left: 1rem; color: var(--sl-color-accent);">Back to pricing</a>
	</section>

	</main>

	<SiteFooter />
</body>
</html>
