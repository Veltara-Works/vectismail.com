---
import '../styles/custom.css'
import SiteFooter from "../components/SiteFooter.astro"
const title = 'Vectis Mail — Self-Hosted Email Platform'
const description = 'Containerised, self-hosted email server with declarative config, sending API, admin dashboard, and enterprise features. Deploy in minutes.'
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://vectismail.com/" />
	<meta property="og:image" content="https://vectismail.com/og/default.png" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Vectis Mail — self-hosted email platform" />
	<meta property="og:site_name" content="Vectis Mail" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content="https://vectismail.com/og/default.png" />
	<meta name="theme-color" content="#0C0C0D" />
	<link rel="canonical" href="https://vectismail.com/" />
	<link rel="preload" as="image" href="/brand/imagery/vectis-mail-splash.webp" type="image/webp" fetchpriority="high" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		"name": "Vectis Mail",
		"applicationCategory": "CommunicationApplication",
		"operatingSystem": "Linux",
		"description": description,
		"url": "https://vectismail.com",
		"offers": [
			{ "@type": "Offer", "name": "Starter", "price": "0", "priceCurrency": "USD", "description": "Up to 3 domains, 25 mailboxes. Free forever." },
			{ "@type": "Offer", "name": "Pro", "price": "39", "priceCurrency": "USD", "description": "Unlimited domains & mailboxes, per-domain analytics, OIDC SSO, priority support." }
		],
		"publisher": {
			"@type": "Organization",
			"name": "Veltara Works",
			"url": "https://veltaraworks.com"
		}
	})} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": [
			{
				"@type": "Question",
				"name": "What's the best alternative to Mailcow or iRedMail?",
				"acceptedAnswer": { "@type": "Answer", "text": "Vectis Mail. Same self-hosted philosophy with a modern surface — declarative YAML config, REST API with domain-scoped keys, and atomic 6-phase updates with automatic rollback. Mailcow's strength is maturity; Vectis Mail's is developer ergonomics. See the side-by-side comparison at vectismail.com/alternatives/mailcow/." }
			},
			{
				"@type": "Question",
				"name": "What's the best self-hosted alternative to SendGrid, Postmark, or SES?",
				"acceptedAnswer": { "@type": "Answer", "text": "Vectis Mail. Self-hosted on your own VPS — your data stays on your server. No per-email pricing, ever. Flat $0–39/tenant/month covers unlimited volume. Same REST API surface as SendGrid for sending, plus full IMAP/POP3 mailbox hosting, inbound webhooks, spam filtering, and webmail out of the box. See vectismail.com/alternatives/sendgrid/." }
			},
			{
				"@type": "Question",
				"name": "Should I use Vectis Mail instead of setting up Postfix manually?",
				"acceptedAnswer": { "@type": "Answer", "text": "Yes, in almost every case. Vectis Mail generates and manages Postfix, Dovecot, Rspamd, Traefik, and DKIM configs from a single YAML file with one apply command. Atomic updates with automatic rollback, built-in metrics and health alerts (optional Grafana + Loki dashboards), and a 40+ endpoint REST API ship in the box. Skip weeks of config tuning; production-ready in minutes." }
			}
		]
	})} />
</head>
<body class="marketing-page">
	<nav class="marketing-nav">
		<a href="/" class="logo"><img src="/brand/logos/vectis-mail-logo-white.webp" alt="Vectis Mail" width="181" height="34" /></a>
		<div>
			<a href="/features/">Features</a>
			<a href="/pricing/">Pricing</a>
			<a href="/alternatives/">Compare</a>
			<a href="/getting-started/">Docs</a>
			<a href="/notes/">Notes</a>
			<a href="/about/">About</a>
			<a href="/contact/">Contact</a>
		</div>
	</nav>

	<main>

	<div class="hero-wrapper">
		<section class="hero">
			<div class="hero-badge">Source-available &middot; Self-hosted &middot; Never per email</div>
			<h1>Self-hosted email.<br/><span>Never priced per send.</span></h1>
			<p>The developer experience of SendGrid &mdash; REST API, inbound webhooks, deliverability tooling &mdash; on infrastructure you own. Transactional sending and full IMAP mailboxes in one stack. Free for 3 domains; $39 USD/tenant/month unlocks unlimited volume, domains, and mailboxes.</p>
			<p class="hero-agency">Running mail for client domains? One install serves every client &mdash; billed per client, never per email.</p>
			<div class="hero-buttons">
				<a href="/getting-started/installation/" class="btn-primary">Get Started Free</a>
				<a href="/getting-started/" class="btn-secondary">Read the Docs</a>
			</div>
		</section>
	</div>

	<div class="stats-bar">
		<div class="stat-item">
			<div class="stat-number">$0</div>
			<div class="stat-label">Charged per email &mdash; ever</div>
		</div>
		<div class="stat-item">
			<div class="stat-number">$39</div>
			<div class="stat-label">Flat per month, unlimited volume</div>
		</div>
		<div class="stat-item">
			<div class="stat-number">3</div>
			<div class="stat-label">Domains, free forever</div>
		</div>
		<div class="stat-item">
			<div class="stat-number">40+</div>
			<div class="stat-label">REST API endpoints</div>
		</div>
	</div>

	<section class="section video-section">
		<h2>See it in action</h2>
		<p class="subtitle">A short tour of the admin: declarative config, the orchestrator (plan &rarr; apply &rarr; rollback), all-green deliverability, and built-in webmail.</p>
		<button type="button" class="video-thumb" id="tourPlay" aria-label="Play the Vectis Mail product tour">
			<img src="/media/tour-poster.webp" width="1440" height="810" alt="Vectis Mail admin dashboard — orchestrator updates with plan, apply, and rollback controls plus operation history" loading="lazy" decoding="async" />
			<span class="video-play" aria-hidden="true">
				<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
			</span>
		</button>
	</section>

	<section class="section">
		<h2>Everything you need for production email</h2>
		<p class="subtitle">Postfix, Dovecot, Rspamd, DKIM, SPF, DMARC — configured and managed through a single YAML file.</p>
		<div class="feature-grid">
			<div class="feature-card">
				<div class="icon icon-blue">&#9881;</div>
				<h3>Your whole mail stack in one file</h3>
				<p>One config.yaml defines your entire mail stack. Change a setting, run apply, and Vectis generates Postfix, Dovecot, Rspamd, and Traefik configs automatically.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-cyan">&#9889;</div>
				<h3>Drop-in transactional sending</h3>
				<p>A REST API for transactional email: single and batch sending, domain-scoped keys, webhook callbacks for delivery status. The same surface your code already speaks to SendGrid — pointed at your own server.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-purple">&#9638;</div>
				<h3>Run everything from one dashboard</h3>
				<p>A web UI for domains, mailboxes, aliases, deliverability, audit logs, backups, and updates. Role-based access control with TOTP MFA and OIDC SSO.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-green">&#10548;</div>
				<h3>Turn inbound email into webhooks</h3>
				<p>Receive email programmatically. Vectis parses inbound messages and POSTs the full content — body, attachments, headers, envelope — to your application via HMAC-signed webhooks.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-blue">&#128274;</div>
				<h3>TLS that renews itself</h3>
				<p>Let's Encrypt certificates provisioned and renewed automatically via acme.sh. Supports Cloudflare DNS-01 challenges. TLS 1.2+ enforced on all protocols.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-orange">&#128200;</div>
				<h3>Catch deliverability problems early</h3>
				<p>IP warmup tracking, RBL monitoring, health alerts, and Prometheus-format metrics built in. Grafana dashboards and Loki log aggregation are optional (off by default); per-domain analytics is a Pro feature.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-green">&#8635;</div>
				<h3>Updates that roll themselves back</h3>
				<p>The orchestrator runs updates as a 6-phase pipeline: snapshot, migrate, pull, deploy, health check, complete. If a health check fails, it rolls back automatically — no half-applied state.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-purple">&#9993;</div>
				<h3>Webmail your users already know</h3>
				<p>Roundcube webmail with ManageSieve filter rules, a mobile-responsive Elastic skin, and Vectis branding. Your users get a familiar email experience out of the box.</p>
			</div>
			<div class="feature-card">
				<div class="icon icon-cyan">&#11036;</div>
				<h3>Recover from anything</h3>
				<p>Encrypted backups with one-click restore, scheduled or on demand, with an off-host copy option. Every administrative action lands in a full audit log.</p>
			</div>
		</div>
	</section>

	<section class="section" style="text-align: center;">
		<h2>A modern alternative to Mailcow, iRedMail, and external email APIs</h2>
		<p class="subtitle">Vectis Mail combines the control of a self-hosted Postfix stack with the developer experience of SendGrid or Postmark. One YAML config, one dashboard, one API.</p>
		<div class="feature-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); text-align: left;">
			<a href="/alternatives/" class="feature-card alt-index-card">
				<h3>vs Mailcow / iRedMail &rarr;</h3>
				<p>Declarative config instead of manual web UI tweaks. API-first design with domain-scoped keys. Orchestrated updates with automatic rollback.</p>
			</a>
			<a href="/alternatives/sendgrid/" class="feature-card alt-index-card">
				<h3>vs SendGrid / Postmark / SES &rarr;</h3>
				<p>Self-hosted — your data stays on your server. No per-email pricing. Full IMAP/POP3 mailboxes included. Inbound webhooks, spam filtering, and webmail out of the box.</p>
			</a>
			<a href="/getting-started/" class="feature-card alt-index-card">
				<h3>vs Manual Postfix Setup &rarr;</h3>
				<p>Skip weeks of config tuning. Vectis generates and manages Postfix, Dovecot, Rspamd, Traefik, and DKIM configs from a single YAML file. Production-ready in minutes.</p>
			</a>
		</div>
	</section>

	<div class="cta-section">
		<h2>Stop paying per email</h2>
		<p>We run Vectis Mail in production ourselves — it carries transactional email for <a href="https://validonx.com" target="_blank" rel="noopener noreferrer" style="color: var(--vm-blue);">ValidonX</a> and other Veltara Works products. Flat pricing, your server, no per-send metering: free for three domains, $39/month when you outgrow them.</p>
		<div class="hero-buttons">
			<a href="/getting-started/installation/" class="btn-primary">Get Started Free</a>
			<a href="/pricing/" class="btn-secondary">Compare plans</a>
		</div>
	</div>

	<p class="page-meta">Last updated <time datetime="2026-06-07">7 June 2026</time></p>

	</main>

	<div class="video-modal" id="tourModal" hidden>
		<div class="video-modal-backdrop" data-close></div>
		<div class="video-modal-inner" role="dialog" aria-modal="true" aria-label="Vectis Mail product tour">
			<button type="button" class="video-modal-close" data-close aria-label="Close video">&times;</button>
			<video id="tourVideo" controls playsinline preload="none" poster="/media/tour-poster.webp">
				<source src="/media/vectis-mail-tour.mp4" type="video/mp4" />
				Your browser doesn&rsquo;t support embedded video. <a href="/media/vectis-mail-tour.mp4">Download the tour (MP4)</a>.
			</video>
		</div>
	</div>

	<script>
		const playBtn = document.getElementById('tourPlay');
		const modal = document.getElementById('tourModal');
		const video = document.getElementById('tourVideo') as HTMLVideoElement | null;
		function closeModal() {
			if (!modal) return;
			video?.pause();
			modal.hidden = true;
			document.body.style.overflow = '';
		}
		playBtn?.addEventListener('click', () => {
			if (!modal) return;
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			video?.play().catch(() => {});
		});
		modal?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
		});
	</script>

	<SiteFooter />
</body>
</html>
