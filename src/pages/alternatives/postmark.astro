				"description": description,
				"url": url,
				"image": ogImage,
				"datePublished": datePublished,
				"dateModified": dateModified,
				"author": { "@type": "Organization", "name": "Vectis Mail", "url": "https://vectismail.com/" },
				"publisher": {
					"@type": "Organization",
					"name": "Vectis Mail",
					"logo": { "@type": "ImageObject", "url": "https://vectismail.com/brand/logos/vectis-mail-logo-white.webp" }
				}
			},
			{
				"@type": "Product",
				"image": ogImage,
				"name": "Vectis Mail",
				"description": "Self-hosted, declarative email platform. Postfix/Dovecot/Rspamd/Traefik packaged with a Go API, React admin UI, and atomic update orchestrator.",
				"url": "https://vectismail.com/",
				"brand": { "@type": "Brand", "name": "Vectis Mail" },
				"offers": [
					{ "@type": "Offer", "name": "Starter", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
					{ "@type": "Offer", "name": "Pro", "price": "39", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M", "billingIncrement": 1, "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitText": "tenant" } } }
				]
			},
			{
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "Is Vectis Mail a drop-in replacement for Postmark?",
						"acceptedAnswer": { "@type": "Answer", "text": "On the transactional sending + inbound parse + webhook surfaces, yes. The migration is mechanical: swap the Postmark SDK call for an HTTP POST, re-map webhook field names, re-create templates, regenerate DKIM keys, update DNS. Vectis Mail also adds mailbox hosting (IMAP/POP3 + webmail) in the same product, which Postmark doesn't. Handy if you've been running Postmark alongside a separate mail server. One scope note: Vectis Mail routes all outbound through one Postfix queue, so if you rely on separate transactional and marketing sender reputations you'll set that up with separate domains or installs — configuration work rather than a built-in stream feature." }
					},
					{
						"@type": "Question",
						"name": "How do the costs compare at scale?",
						"acceptedAnswer": { "@type": "Answer", "text": "Postmark's base plans start at $15–18/month for 10,000 emails, with overages at $1.20–1.80 per thousand depending on tier. At 100,000 emails/month you're paying roughly $134/month on Pro; at 1 million you're around $1,200/month on Platform. Vectis Mail is $59/month flat regardless of volume (Pro tier at $39 USD/tenant + a $20 VPS to host it). The cost crossover lands roughly in the mid-tens of thousands of emails per month, depending on your Postmark plan and overage rate. Past that point, every email Postmark sends costs you something, while every email Vectis Mail sends costs nothing additional." }
