---
import '../../styles/custom.css'
import SiteFooter from "../../components/SiteFooter.astro"
import SiteNav from "../../components/SiteNav.astro"
const title = 'Proton Mail Alternative — Email You Own | Vectis Mail'
const description = 'The self-hosted Proton Mail alternative: your VPS, your domain, standard IMAP/SMTP, any client, flat unmetered pricing. Privacy you own, not rent.'
const url = 'https://vectismail.com/alternatives/proton-mail/'
const ogImage = 'https://vectismail.com/og/alternatives-proton-mail.png'
const datePublished = '2026-06-21'
const dateModified = '2026-07-07'
---
<html lang="en">
<head>
	<link rel="preload" href="/brand/fonts/Inter-VariableFont_opsz_wght.woff2" as="font" type="font/woff2" crossorigin />
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />

	<link rel="canonical" href={url} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />

	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="article" />
	<meta property="og:url" content={url} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Vectis Mail vs Proton Mail — self-hosted private email comparison" />
	<meta property="og:site_name" content="Vectis Mail" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	<meta name="theme-color" content="#0C0C0D" />

	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "BreadcrumbList",
				"itemListElement": [
					{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://vectismail.com/" },
					{ "@type": "ListItem", "position": 2, "name": "Alternatives", "item": "https://vectismail.com/alternatives/" },
					{ "@type": "ListItem", "position": 3, "name": "Proton Mail", "item": url }
				]
			},
			{
				"@type": "Article",
				"@id": url + "#article",
				"headline": "Vectis Mail vs Proton Mail",
				"description": description,
				"url": url,
				"image": ogImage,
				"datePublished": datePublished,
				"dateModified": dateModified,
				"author": { "@type": "Organization", "name": "Vectis Mail", "url": "https://vectismail.com/" },
				"publisher": {
					"@type": "Organization",
					"name": "Vectis Mail",
					"logo": { "@type": "ImageObject", "url": "https://vectismail.com/brand/logos/vectis-mail-logo-white.webp" }
				}
			},
			{
				"@type": "Product",
				"image": ogImage,
				"name": "Vectis Mail",
				"description": "Self-hosted, declarative email server you run on your own VPS. Standard IMAP/SMTP mailboxes, your domain, DKIM/SPF/DMARC, a Go REST API and React admin UI. Privacy through infrastructure ownership rather than a hosted service.",
				"url": "https://vectismail.com/",
				"brand": { "@type": "Brand", "name": "Vectis Mail" },
				"offers": [
					{ "@type": "Offer", "name": "Starter", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
					{ "@type": "Offer", "name": "Pro", "price": "39", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M", "billingIncrement": 1, "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitText": "tenant" } } }
				]
			},
			{
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "Can I use Vectis Mail with my own domain and any email client?",
						"acceptedAnswer": { "@type": "Answer", "text": "Yes. Vectis Mail runs on your own VPS and speaks standard IMAP and SMTP, so any client — Thunderbird, Apple Mail, Outlook, mobile apps, mutt — connects directly with no bridge software. Custom domains are first-class: you point MX/DKIM/SPF/DMARC at your server and host unlimited addresses on Pro, with no per-plan domain cap." }
					},
					{
						"@type": "Question",
						"name": "What does Vectis Mail cost compared to Proton Mail?",
						"acceptedAnswer": { "@type": "Answer", "text": "Vectis Mail Starter is $0 for the software — self-hosted, up to 3 domains and 25 mailboxes per domain — you pay only for a VPS, typically $5–$20/month. Pro is $39 USD per tenant per month for unlimited domains and mailboxes, plus the REST API, analytics and OIDC SSO, and one subscription covers every install your organisation runs. Where hosted mail charges per address bracket, Vectis charges per organisation and never per mailbox or per email." }
					},
					{
						"@type": "Question",
						"name": "Is Vectis Mail end-to-end encrypted?",
						"acceptedAnswer": { "@type": "Answer", "text": "No, and that is deliberate. Vectis Mail is a standard Postfix/Dovecot mail server, so as the operator you hold and can read your own mail at rest. Its privacy model is ownership: no third party holds your mail, sees your social graph, or can be compelled to hand it over. Mail in transit is protected by TLS. If your specific requirement is client-side encryption the host cannot read, that is a hosted-encryption product — a different category from a mail server you run." }
					},
					{
						"@type": "Question",
						"name": "How do I migrate from Proton Mail to a self-hosted server?",
						"acceptedAnswer": { "@type": "Answer", "text": "On a paid Proton plan, run Proton Bridge to expose your mailbox over local IMAP, then use imapsync to copy mail into your Vectis Mail mailbox. Move your custom domain's MX/DKIM/SPF/DMARC records to point at the Vectis server, recreate addresses and Sieve filters, and cut DNS over once mail is flowing. Export contacts and calendar from Proton separately (Vectis does not yet ship CalDAV/CardDAV — that is on the Phase 4 roadmap)." }
					}
				]
			}
		]
	})} />
</head>
<body class="marketing-page">
	<SiteNav />

	<main>

	<section class="hero alt-hero">
		<div class="hero-badge">Alternatives · Private Email</div>
		<h1>The Proton Mail alternative<br/><span>you actually own.</span></h1>
		<p class="alt-lead">
			Proton keeps your mail on Proton's servers, in Switzerland, under Proton's plans.
			Vectis Mail puts it on <em>yours</em> — a standard mail server on your own VPS, your
			domain, standard IMAP/SMTP, no provider in the loop. Same instinct for privacy,
			without renting it back from anyone.
		</p>
		<div class="hero-buttons" style="margin-top: 1.5rem;">
			<a href="/getting-started/installation/" class="btn-primary">Install Vectis Mail free</a>
			<a href="/pricing/" class="btn-secondary">View pricing</a>
		</div>
		<div class="alt-meta" style="margin-top: 1.25rem;">
			<span>Last updated <time datetime={dateModified}>7 July 2026</time></span>
			<span>·</span>
			<span>By the Vectis Mail team</span>
		</div>
	</section>

	<section class="section" style="padding-top: 2rem;">
		<h2>Why teams move to Vectis Mail</h2>
		<p class="subtitle">Four reasons operators leave hosted mailboxes behind.</p>
		<div class="feature-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 1.5rem;">
			<div class="feature-card">
				<h3 style="margin-top: 0;">You own the infrastructure</h3>
				<p style="margin-bottom: 0;">Your server, your keys, your domain. There's no third party that could be breached, served a warrant, change its pricing, or shut the service down. The provider isn't more trustworthy — it's simply gone.</p>
			</div>
			<div class="feature-card">
				<h3 style="margin-top: 0;">Any client, no bridge</h3>
				<p style="margin-bottom: 0;">Vectis speaks plain IMAP and SMTP, so Thunderbird, Apple Mail, Outlook, mobile and mutt connect directly. No local daemon to run on every device just to read your own mail.</p>
			</div>
			<div class="feature-card">
				<h3 style="margin-top: 0;">Flat, unmetered pricing</h3>
				<p style="margin-bottom: 0;">Unlimited domains and mailboxes on one $39/mo Pro plan — no per-address brackets, no per-email metering. Starter is $0 for the software; you pay only for a $5–$20/mo VPS.</p>
			</div>
			<div class="feature-card">
				<h3 style="margin-top: 0;">Built to run in production</h3>
				<p style="margin-bottom: 0;">Declarative YAML config, a Go REST API, a React admin UI, and atomic updates with health-gated rollback. Not a hobby stack — a mail server you can operate and trust.</p>
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 1rem;">
		<h2>At a glance</h2>
		<p class="subtitle">Side-by-side, current as of July 2026.</p>
		<div class="compare-table-wrap">
			<table class="compare-table">
				<thead>
					<tr><th></th><th>Vectis Mail</th><th>Proton Mail</th></tr>
				</thead>
				<tbody>
					<tr><th scope="row">Model</th><td><strong>A mail server you own</strong></td><td>Hosted mailbox service</td></tr>
					<tr><th scope="row">Where your mail lives</th><td><strong>Your VPS, your disk</strong></td><td>Proton's servers in Switzerland</td></tr>
					<tr><th scope="row">Email clients</th><td><strong>Any — direct IMAP/SMTP</strong></td><td>Proton apps; others need Proton Bridge (paid)</td></tr>
					<tr><th scope="row">Custom domains</th><td><strong>Unlimited on Pro</strong></td><td>Paid only (1 on Plus, 3 on Unlimited)</td></tr>
					<tr><th scope="row">Mailboxes</th><td><strong>25/domain (Starter) · unlimited (Pro)</strong></td><td>1 (Free) · up to 10–15 addresses (paid)</td></tr>
					<tr><th scope="row">REST sending API + webhooks</th><td><strong>Yes</strong></td><td>No</td></tr>
					<tr><th scope="row">Jurisdiction</th><td><strong>Wherever you deploy</strong></td><td>Switzerland (Swiss law applies)</td></tr>
					<tr><th scope="row">Lock-in</th><td><strong>None — standard maildir, export anytime</strong></td><td>Encrypted store; export via Bridge/tools</td></tr>
					<tr><th scope="row">Encryption model</th><td>Standard TLS in transit; you hold the store</td><td>Client-side E2E + zero-access at rest</td></tr>
					<tr><th scope="row">Pricing</th><td><strong>$0 software + VPS · $39/mo Pro, unlimited</strong></td><td>~$3.99–$9.99/mo per mailbox (annual)</td></tr>
				</tbody>
			</table>
		</div>
		<p style="font-size: 0.85rem; color: var(--sl-color-gray-3); margin-top: 0.5rem;">
			Proton facts per Proton's published pricing and Bridge documentation, retrieved 2026-06-21.
		</p>
	</section>

	<section class="section" style="padding-top: 1rem;">
		<h2>Privacy you own, not rent</h2>
		<p>
			Both products start from the same discomfort: you don't want a stranger's servers
			holding your email. They answer it differently. Proton's answer is encryption — your
			mail stays on Proton's infrastructure, encrypted so Proton can't read the bodies.
			Vectis Mail's answer is ownership — there's no provider at all. It's a standard
			Postfix/Dovecot server on a VPS you control, with your domain and standard protocols,
			so the question "can I trust the host?" simply doesn't arise.
		</p>
		<p>
			That ownership is the whole product. Mail sits in a plain maildir on your disk — back
			it up, <code>imapsync</code> it anywhere, or walk away whenever you like, with nothing
			held hostage. Domains and mailboxes are just configuration, not plan tiers. And one
			$39/mo Pro subscription covers unlimited domains, unlimited mailboxes, the REST API,
			analytics and OIDC SSO across every install your organisation runs.
		</p>
		<p style="font-size: 0.92rem; color: var(--sl-color-gray-3);">
			One honest note for the technically-minded: Vectis Mail is a standard mail server, not
			a client-side-encrypted one — as the operator you hold your mail and can read it,
			because <em>you</em> hold it rather than a provider. That's the design, and it's the
			point of owning the server.
		</p>
	</section>

	<section class="section" style="padding-top: 1rem;">
		<h2>Moving over is straightforward</h2>
		<p>
			Standard protocols on the Vectis side make the switch a normal migration, not an export-fight:
		</p>
		<ol class="alt-steps">
			<li><strong>Stand up Vectis Mail</strong> on a fresh VPS with the <a href="/getting-started/installation/">installation guide</a>, and configure your domain(s) with DKIM/SPF/DMARC.</li>
			<li><strong>Enable Proton Bridge</strong> (paid Proton plan) to expose your Proton mailbox over local IMAP/SMTP.</li>
			<li><strong>Sync mail</strong> with <code>imapsync</code> from Bridge's localhost endpoint straight into your Vectis mailboxes.</li>
			<li><strong>Recreate addresses and Sieve filters</strong>, and point your custom-domain DNS (MX/DKIM/SPF/DMARC) at the Vectis server.</li>
			<li><strong>Cut DNS over</strong> once mail is flowing, warm the IP (see the <a href="/guides/ip-warmup/">IP warmup guide</a>), then decommission Proton after a clean verification window.</li>
		</ol>
	</section>

	<section class="section" style="padding-top: 1rem;">
		<h2>Frequently asked questions</h2>
		<div class="alt-faq">
			<div class="alt-faq-q">
				<h3>Can I use Vectis Mail with my own domain and any email client?</h3>
				<p>
					Yes. Vectis speaks standard IMAP and SMTP, so Thunderbird, Apple Mail, Outlook,
					mobile apps and mutt connect directly — no bridge software. Custom domains are
					first-class: point MX/DKIM/SPF/DMARC at your server and host unlimited addresses
					on Pro, with no per-plan domain cap.
				</p>
			</div>
			<div class="alt-faq-q">
				<h3>What does Vectis Mail cost compared to Proton Mail?</h3>
				<p>
					Vectis <a href="/pricing/">Starter</a> is $0 for the software — self-hosted, up to
					3 domains and 25 mailboxes per domain — you pay only for a $5–$20/month VPS. Pro is
					a flat $39 USD per tenant per month for unlimited domains and mailboxes, plus the
					REST API, analytics and OIDC SSO, and one subscription covers every install you run.
					Where hosted mail charges per address bracket, Vectis charges per organisation and
					never per mailbox or per email.
				</p>
			</div>
			<div class="alt-faq-q">
				<h3>Is Vectis Mail end-to-end encrypted?</h3>
				<p>
					No — and that's deliberate. Vectis Mail is a standard Postfix/Dovecot server, so as
					the operator you hold and can read your own mail at rest. Its privacy model is
					ownership: no third party holds your mail, sees your social graph, or can be
					compelled to hand it over. Mail in transit is protected by TLS. If your specific
					requirement is client-side encryption the host can't read, that's a hosted-encryption
					product — a different category from a mail server you run.
				</p>
			</div>
			<div class="alt-faq-q">
				<h3>How do I migrate from Proton Mail to a self-hosted server?</h3>
				<p>
					On a paid Proton plan, run <strong>Proton Bridge</strong> to expose your mailbox over
					local IMAP, then <code>imapsync</code> it into Vectis. Move your custom domain's
					MX/DKIM/SPF/DMARC to point at the Vectis server, recreate addresses and Sieve filters,
					and cut DNS over once mail is flowing. Export contacts and calendar from Proton
					separately (CalDAV/CardDAV is on the Phase 4 roadmap).
				</p>
			</div>
		</div>
	</section>

	<div class="cta-section">
		<h2>Own your email</h2>
		<p>Your server, your domain, standard protocols. Privacy you own, not rent.</p>
		<div class="hero-buttons">
			<a href="/getting-started/installation/" class="btn-primary">Install Vectis Mail free</a>
			<a href="/pricing/" class="btn-secondary">View pricing</a>
		</div>
		<p style="font-size: 0.85rem; color: var(--sl-color-gray-3); margin-top: 0.75rem;">Free Starter tier · No credit card required · Source-available</p>
	</div>

	<section class="section other-alts">
		<h2>Other Vectis Mail alternatives</h2>
		<p class="subtitle">Coming from a different stack? Read the comparison that matches it.</p>
		<div class="feature-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
			<a href="/alternatives/google-workspace/" class="feature-card alt-index-card">
				<h3>vs Google Workspace &rarr;</h3>
				<p>Hosted seats vs a server you own. Per-seat billing vs flat per-tenant pricing.</p>
			</a>
			<a href="/alternatives/migadu/" class="feature-card alt-index-card">
				<h3>vs Migadu &rarr;</h3>
				<p>Flat-rate hosted email vs self-hosted ownership with a REST API and atomic updates.</p>
			</a>
			<a href="/alternatives/mailcow/" class="feature-card alt-index-card">
				<h3>vs Mailcow &rarr;</h3>
				<p>Same self-hosted stack, declarative YAML config, REST API, atomic updates with rollback.</p>
			</a>
		</div>
	</section>

	</main>

	<SiteFooter />
</body>
</html>
