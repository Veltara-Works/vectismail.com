					<tr><th scope="row">Antispam (default)</th><td><strong>Rspamd</strong> (modern heuristics)</td><td>SpamAssassin</td></tr>
					<tr><th scope="row">Multi-domain</th><td><strong>Built-in</strong>: many domains on one install</td><td>Single-org-shaped</td></tr>
					<tr><th scope="row">Per-domain analytics</th><td><strong>Yes</strong> (Pro)</td><td>No</td></tr>
					<tr><th scope="row">Webmail</th><td>Roundcube</td><td>Roundcube</td></tr>
					<tr><th scope="row">Calendar / contacts (CalDAV/CardDAV)</th><td>Not yet (Phase 4 roadmap)</td><td>Yes (Nextcloud-based)</td></tr>
