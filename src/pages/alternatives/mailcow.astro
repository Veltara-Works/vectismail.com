					<tr><th scope="row">Webmail</th><td>Roundcube</td><td>SOGo</td></tr>
					<tr><th scope="row">Calendar / contacts (CalDAV/CardDAV)</th><td>Not yet (Phase 4 roadmap)</td><td>Yes (SOGo)</td></tr>
					<tr><th scope="row">Admin UI</th><td>React SPA</td><td>PHP / Twig</td></tr>
					<tr><th scope="row">License</th><td>Business Source License 1.1 (auto-Apache 2.0 after 4y); commercial Pro license</td><td>GPL-3.0</td></tr>
					<tr><th scope="row">Pricing</th><td>$0 Starter · $39 USD/tenant/month Pro</td><td>$0 · paid ServerCow support optional</td></tr>
					<tr><th scope="row">Maturity</th><td>v0.1.x — production since April 2026</td><td>12+ years, large community</td></tr>
