---
import Default from '@astrojs/starlight/components/Head.astro'
import type { SidebarEntry, SidebarLink, SidebarGroup } from '@astrojs/starlight/schema'

type FindResult = { group: SidebarGroup | null; link: SidebarLink }

function findCurrent(entries: SidebarEntry[], parent: SidebarGroup | null): FindResult | null {
	for (const entry of entries) {
		if (entry.type === 'link' && entry.isCurrent) {
			return { group: parent, link: entry }
		}
		if (entry.type === 'group') {
			const found = findCurrent(entry.entries, entry)
			if (found) return found
		}
	}
	return null
}

function groupHref(group: SidebarGroup): string | null {
	for (const entry of group.entries) {
		if (entry.type === 'link') return entry.href
		if (entry.type === 'group') {
			const nested = groupHref(entry)
			if (nested) return nested
		}
	}
	return null
}

function isoDay(d: Date | undefined): string {
	const date = d instanceof Date ? d : new Date()
	return date.toISOString().slice(0, 10)
}

const SITE = 'https://vectismail.com'
const LAUNCH_DATE = '2026-04-03'
const route = Astro.locals.starlightRoute
const found = findCurrent(route.sidebar, null)

const items: { '@type': 'ListItem'; position: number; name: string; item: string }[] = [
	{ '@type': 'ListItem', position: 1, name: 'Vectis Mail', item: SITE + '/' },
]

if (found) {
	if (found.group) {
		const href = groupHref(found.group)
		if (href) {
			items.push({
				'@type': 'ListItem',
				position: items.length + 1,
				name: found.group.label,
				item: new URL(href, SITE).toString(),
			})
		}
	}
	items.push({
		'@type': 'ListItem',
		position: items.length + 1,
		name: found.link.label,
		item: new URL(found.link.href, SITE).toString(),
	})
}

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items,
}

const data = route.entry.data
const pageUrl = new URL(found?.link.href ?? '/', SITE).toString()
const techArticle = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: data.title,
	description: data.description ?? 'Vectis Mail documentation',
	url: pageUrl,
	datePublished: LAUNCH_DATE,
	dateModified: isoDay(route.lastUpdated),
	inLanguage: 'en',
	author: {
		'@type': 'Organization',
		name: 'Vectis Mail',
		url: 'https://vectismail.com/about/',
	},
	publisher: {
		'@type': 'Organization',
		name: 'Vectis Mail',
		logo: {
			'@type': 'ImageObject',
			url: 'https://vectismail.com/brand/logos/vectis-mail-logo-white.png',
		},
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
}
---
<Default {...Astro.props}><slot /></Default>
{items.length >= 2 && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
)}
{found && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(techArticle)} />
)}
