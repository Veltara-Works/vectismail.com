---
import Default from '@astrojs/starlight/components/Head.astro'

type SidebarLink = { type: 'link'; label: string; href: string; isCurrent: boolean }
type SidebarGroup = { type: 'group'; label: string; entries: SidebarEntry[] }
type SidebarEntry = SidebarLink | SidebarGroup
type HowToStep = { name: string; url: string; text?: string }
type FaqItem = { q: string; a: string }

type FindResult = { group: SidebarGroup | null; link: SidebarLink }

function findCurrent(entries: SidebarEntry[], parent: SidebarGroup | null): FindResult | null {
	for (const entry of entries) {
		if (entry.type === 'link' && entry.isCurrent) {
			return { group: parent, link: entry }
		}
		if (entry.type === 'group') {
			const found = findCurrent(entry.entries, entry)
			if (found) return found
		}
	}
	return null
}

function groupHref(group: SidebarGroup): string | null {
	for (const entry of group.entries) {
		if (entry.type === 'link') return entry.href
		if (entry.type === 'group') {
			const nested = groupHref(entry)
			if (nested) return nested
		}
	}
	return null
}

function isoDay(d: Date | undefined): string {
	const date = d instanceof Date ? d : new Date()
	return date.toISOString().slice(0, 10)
}

const SITE = 'https://vectismail.com'
const LAUNCH_DATE = '2026-04-03'
const route = Astro.locals.starlightRoute
const found = findCurrent(route.sidebar, null)

const items: { '@type': 'ListItem'; position: number; name: string; item: string }[] = [
	{ '@type': 'ListItem', position: 1, name: 'Vectis Mail', item: SITE + '/' },
]

if (found) {
	if (found.group) {
		const href = groupHref(found.group)
		if (href) {
			items.push({
				'@type': 'ListItem',
				position: items.length + 1,
				name: found.group.label,
				item: new URL(href, SITE).toString(),
			})
		}
	}
	items.push({
		'@type': 'ListItem',
		position: items.length + 1,
		name: found.link.label,
		item: new URL(found.link.href, SITE).toString(),
	})
}

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items,
}

const data = route.entry.data as typeof route.entry.data & {
	howToName?: string
	howToSteps?: Array<{ name: string; url: string; text?: string }>
	faq?: Array<{ q: string; a: string }>
}
const pageUrl = new URL(found?.link.href ?? '/', SITE).toString()

// Narrative content (guides + getting-started) is bylined to a Person (A3);
// reference docs (API / CLI / architecture) stay authored by the Organization.
const slug = route.id ?? ''
const isNarrative = slug.startsWith('guides/') || slug.startsWith('getting-started')
const articleAuthor = isNarrative
	? { '@type': 'Person', name: 'Ian Holt', url: 'https://vectismail.com/about/' }
	: { '@type': 'Organization', name: 'Vectis Mail', url: 'https://vectismail.com/about/' }

const techArticle = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: data.title,
	description: data.description ?? 'Vectis Mail documentation',
	url: pageUrl,
	datePublished: LAUNCH_DATE,
	dateModified: isoDay(route.lastUpdated),
	inLanguage: 'en',
	author: articleAuthor,
	publisher: {
		'@type': 'Organization',
		name: 'Vectis Mail',
		logo: {
			'@type': 'ImageObject',
			url: 'https://vectismail.com/brand/logos/vectis-mail-logo-white.webp',
		},
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
}

const howTo = data.howToSteps && data.howToSteps.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: data.howToName ?? data.title,
	description: data.description ?? '',
	url: pageUrl,
	datePublished: LAUNCH_DATE,
	dateModified: isoDay(route.lastUpdated),
	inLanguage: 'en',
	author: articleAuthor,
	publisher: {
		'@type': 'Organization',
		name: 'Vectis Mail',
		logo: {
			'@type': 'ImageObject',
			url: 'https://vectismail.com/brand/logos/vectis-mail-logo-white.webp',
		},
	},
	step: data.howToSteps.map((s: HowToStep, i: number) => ({
		'@type': 'HowToStep',
		position: i + 1,
		name: s.name,
		url: pageUrl + s.url,
		text: s.text ?? s.name,
	})),
} : null

const faqPage = data.faq && data.faq.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: data.faq.map((f: FaqItem) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
} : null
---
<Default {...Astro.props}><slot /></Default>
{items.length >= 2 && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
)}
{found && howTo === null && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(techArticle)} />
)}
{howTo && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(howTo)} />
)}
{faqPage && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage)} />
)}
