---
// Reusable product-updates capture. Posts to /api/subscribe, which writes a
// PENDING row to D1 and emails a double-opt-in confirm link (via the Vectis
// Mail send API — we dogfood our own product). The subscriber is only added
// to the list after they click the confirm link.
//
// Multi-instance safe: every form is wired by class, scoped to its own status
// element, so a page may render more than one (e.g. the site footer plus an
// inline content-upgrade inside a guide).
interface Props {
	/** Where this capture lives, recorded against the signup (e.g. "footer", "docs", "guide:ip-warmup"). */
	source?: string
	heading?: string
	blurb?: string
	/** Tighter spacing for embedding inside docs/guide content. */
	compact?: boolean
}
const {
	source = 'footer',
	heading = 'Get product updates',
	blurb = 'Occasional email on new releases and self-hosting guides. No spam, unsubscribe anytime.',
	compact = false,
} = Astro.props
const headingId = `nl-h-${source.replace(/[^a-z0-9]+/gi, '-')}`
---
<section class:list={['nl-subscribe', { 'nl-compact': compact }]} aria-labelledby={headingId}>
	<div class="nl-inner">
		<div class="nl-copy">
			<h2 id={headingId}>{heading}</h2>
			<p>{blurb}</p>
		</div>
		<form class="js-subscribe-form subscribe-form" data-source={source} novalidate>
			<label class="sr-only" for={`nl-email-${headingId}`}>Email address</label>
			<input id={`nl-email-${headingId}`} class="nl-email" name="email" type="email" inputmode="email"
				autocomplete="email" required placeholder="you@example.com" />
			<!-- Honeypot: hidden from humans, bots fill it. -->
			<input class="subscribe-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
			<button type="submit" class="btn-primary">Subscribe</button>
		</form>
		<p class="subscribe-status nl-status" role="status" aria-live="polite"></p>
	</div>
</section>

<style>
	.nl-subscribe {
		border-top: 1px solid var(--sl-color-gray-5, #2a2a2e);
		padding: 2.5rem 1.5rem 0;
	}
	.nl-subscribe.nl-compact {
		padding: 2rem 0 0;
		margin-top: 2.5rem;
	}
	.nl-inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
	}
	.nl-compact .nl-inner {
		max-width: 100%;
	}
	.nl-subscribe h2 {
		margin: 0 0 0.25rem;
		font-size: 1.1rem;
	}
	.nl-subscribe p {
		margin: 0;
		font-size: 0.9rem;
		opacity: 0.8;
	}
	.subscribe-form {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.subscribe-form input[type='email'] {
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5, #3a3a3e);
		border-radius: 6px;
		background: var(--sl-color-black, #0c0c0d);
		color: inherit;
		font-size: 0.95rem;
		min-width: 240px;
	}
	.subscribe-form .btn-primary {
		white-space: nowrap;
	}
	.subscribe-hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.subscribe-status {
		max-width: 960px;
		margin: 0.75rem auto 0;
		font-size: 0.9rem;
		min-height: 1.2em;
	}
	.nl-compact .subscribe-status {
		max-width: 100%;
	}
	.subscribe-status.ok {
		color: #4ade80;
	}
	.subscribe-status.err {
		color: #f87171;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
	document.querySelectorAll<HTMLFormElement>('.js-subscribe-form').forEach((form) => {
		const statusEl = form.parentElement?.querySelector('.nl-status') as HTMLElement | null
		const emailEl = form.querySelector('input[name="email"]') as HTMLInputElement | null
		const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
		form.addEventListener('submit', async (e) => {
			e.preventDefault()
			if (!emailEl || !statusEl) return
			const email = emailEl.value.trim()
			const company = (form.querySelector('input[name="company"]') as HTMLInputElement | null)?.value || ''
			if (!email || !EMAIL_RE.test(email)) {
				statusEl.textContent = 'Please enter a valid email address.'
				statusEl.className = 'subscribe-status nl-status err'
				return
			}
			if (btn) btn.disabled = true
			statusEl.textContent = 'Subscribing…'
			statusEl.className = 'subscribe-status nl-status'
			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, company, source: form.dataset.source || 'footer' }),
				})
				if (res.ok) {
					form.reset()
					statusEl.textContent = 'Almost there — check your inbox to confirm your subscription.'
					statusEl.className = 'subscribe-status nl-status ok'
				} else {
					statusEl.textContent = 'Something went wrong. Please try again.'
					statusEl.className = 'subscribe-status nl-status err'
				}
			} catch {
				statusEl.textContent = 'Network error. Please try again.'
				statusEl.className = 'subscribe-status nl-status err'
			} finally {
				if (btn) btn.disabled = false
			}
		})
	})
</script>
