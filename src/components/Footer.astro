---
// Custom Starlight Footer override.
// Adds a site-wide footer with links matching the marketing pages.
import type { Props } from '@astrojs/starlight/props'

// Author byline on narrative content (guides + getting-started tutorials),
// not on reference docs (API / CLI / architecture). A3 (AI-SEO): visible
// byline pairs with the Person author in the page's Article/HowTo schema.
const slug = Astro.locals.starlightRoute?.id ?? ''
const showByline = slug.startsWith('guides/') || slug.startsWith('getting-started')
---
{showByline && (
	<p class="doc-byline">
		<img class="byline-avatar" src="/brand/imagery/ian-holt-avatar.webp" alt="Ian Holt" width="28" height="28" loading="lazy" decoding="async" />
		<span>Written by <a href="/about/">Ian Holt</a></span>
	</p>
)}
<footer class="doc-footer">
	<div class="doc-footer-inner">
		<span>&copy; 2026 Veltara Works&trade;. All rights reserved.</span>
		<nav>
			<a href="/">Home</a>
			<a href="/features/">Features</a>
			<a href="/pricing/">Pricing</a>
			<a href="/about/">About</a>
			<a href="/contact/">Contact</a>
			<a href="/privacy/">Privacy</a>
			<a href="/terms/">Terms</a>
			<a href="https://github.com/Veltara-Works/vectis">GitHub</a>
		</nav>
	</div>
</footer>

<style>
	.doc-byline {
		max-width: 1400px;
		margin: 3rem auto 0;
		padding: 0 1.5rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3, #8b949e);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.doc-byline a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.byline-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.doc-footer {
		border-top: 1px solid var(--sl-color-gray-5, #21262d);
		margin-top: 1.5rem;
		padding: 2rem 1.5rem;
	}

	.doc-footer-inner {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3, #8b949e);
	}

	.doc-footer nav {
		display: flex;
		gap: 1.25rem;
	}

	.doc-footer a {
		color: var(--sl-color-gray-3, #8b949e);
		text-decoration: none;
		transition: color 0.15s;
	}

	.doc-footer a:hover {
		color: var(--sl-color-gray-1, #e6edf3);
	}
</style>
