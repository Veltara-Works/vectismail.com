---
// Custom Starlight Header override.
// Stacks the site-wide top navigation above Starlight's built-in header row.
// The "Docs header" block in custom.css sizes the two rows.
import type { Props } from '@astrojs/starlight/props'
import Default from '@astrojs/starlight/components/Header.astro'
import TopNav from './TopNav.astro'
---
<TopNav />
<div class="vm-header-row">
	<Default {...Astro.props}><slot /></Default>
</div>
