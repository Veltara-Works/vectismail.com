---
// Custom Starlight Sidebar override.
// Below 50rem the docs header hides TopNav, so the site-wide links go at the
// top of Starlight's mobile menu instead. Hidden on desktop, where TopNav
// shows them.
import type { Props } from '@astrojs/starlight/props'
import Default from '@astrojs/starlight/components/Sidebar.astro'
import { siteLinks } from './site-links'
---
<nav class="site-links" aria-label="Site">
	<ul>
		{siteLinks.map((link) => (
			<li><a href={link.href}>{link.label}</a></li>
		))}
	</ul>
</nav>
<Default {...Astro.props}><slot /></Default>

<style>
	.site-links ul {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0 0 0.75rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.25rem 1rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}

	.site-links a {
		display: block;
		/* Line up with the sidebar group labels (Starlight's 0.5rem item inset). */
		padding-inline: 0.5rem;
		/* ≥24px tap target (WCAG 2.5.8), matching the marketing nav. */
		padding-block: 0.5rem;
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}

	@media (min-width: 50rem) {
		.site-links {
			display: none;
		}
	}
</style>
